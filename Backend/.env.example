# Site Audit — environment variables
#
# Copy to .env and fill in. Every key below is referenced by the code; the list is
# generated from process.env.* and configService.getConfig() call sites, so it stays
# in sync with what the app actually reads (architecture doc §11).
#
# Values may also live in the platform_configs collection, which takes precedence
# over these — see services/configService.js.

# ── Core ──────────────────────────────────────────────────────
# Allowed browser origin(s), comma-separated. Apex and www are both derived.
FRONTEND_URL=
# MongoDB connection string. Cosmos for MongoDB (vCore) in production.
MONGO_URI=
# Port the API binds to. Default 2000.
PORT=

# ── Auth & security ───────────────────────────────────────────
# Legacy config encryption key, kept for existing rows.
CONFIG_ENCRYPTION_KEY=
# Master key for encrypted platform config values.
ENCRYPTION_KEY=
# OAuth redirect URI. Must match the registered value exactly.
GOOGLE_CALLBACK_URL=
# Google OAuth client id.
GOOGLE_CLIENT_ID=
# Google OAuth client secret.
GOOGLE_CLIENT_SECRET=
# Refresh-token lifetime, e.g. 7d.
JWT_EXPIRES_IN=
# Signing secret for access tokens. Must be long and random.
JWT_SECRET=
# express-session secret. Server refuses to boot if under 16 chars.
SESSION_SECRET=

# ── Third-party APIs ──────────────────────────────────────────
# Google PageSpeed Insights key. Core Web Vitals come from here.
API_KEY=
# Gemini key for AI explanations.
GEMINI_API_KEY=
# Google Knowledge Graph key (entity checks).
KG_API_KEY=
# Google Safe Browsing key (security pillar).
SafeBrowsing=
# VirusTotal key (security pillar).
vt_key=

# ── Email ─────────────────────────────────────────────────────
# From address on outgoing mail. MUST be an address the SMTP account below is
# authorised to send as — the same mailbox, a verified alias, or a domain you own
# and have added to the provider. A From on any other domain fails SPF/DKIM
# alignment at the RECIPIENT and is spam-filed or dropped, even though the relay
# answers 250 OK and our logs say "sent". sendEmail.js therefore rewrites an
# unauthorised From to SMTP_USER rather than let mail vanish; leave this blank to
# get that behaviour deliberately.
EMAIL_FROM=
# Set to true ONLY when EMAIL_FROM really is authorised (verified alias, own
# domain, or a relay like SendGrid/Postmark built for third-party senders). This
# disables the rewrite above — set it wrongly and mail silently stops arriving.
EMAIL_FROM_VERIFIED=
# SMTP host for transactional mail.
SMTP_HOST=
# SMTP password. Gmail requires a 16-character App Password, not the account password.
SMTP_PASS=
# SMTP port. 587 for STARTTLS, 465 for implicit TLS.
SMTP_PORT=
# SMTP username — the full mailbox address you authenticate as.
SMTP_USER=

# ── Tuning ────────────────────────────────────────────────────
AUDIT_IDLE_FLUSH_MS=
AUDIT_MEM_TTL_MS=
AUDIT_REPORT_TTL_SECONDS=
AUDIT_WRITE_BATCH_SIZE=
BROWSER_POOL_WATCHDOG_MS=
BROWSER_SLOT_MAX_HOLD_MS=
CONSOLE_LOG_LEVEL=
DEBUG=
FILE_LOG_LEVEL=
LOG_LEVEL=
# Headless Chrome cap. Raising it costs RAM and CPU.
MAX_CONCURRENT_BROWSERS=
MAX_KEY_PAGES=
PAGESPEED_ATTEMPT_TIMEOUT_MS=
PILLAR_SEC_TIMEOUT_MS=
PILLAR_SEO_TIMEOUT_MS=
PILLAR_TECH_TIMEOUT_MS=
PILLAR_TIMEOUT_MS=
PSI_CACHE_MAX_ENTRIES=
PSI_CACHE_TTL_MS=
PSI_PREFETCH_CONCURRENCY=
# Max requests per window per IP.
RATE_LIMIT_MAX_REQUESTS=
# Global rate-limit window in ms.
RATE_LIMIT_WINDOW_MS=
REPORT_BUDGET_MAX=
REPORT_BUDGET_WINDOW_MS=
STATIC_FILE_CACHE_TTL_MS=
UX_LINK_CHECK_CONCURRENCY=
UX_MAX_LINK_CHECKS=
WAF_HARD_BLOCK_COOLOFF_MS=
WAF_MAX_INFLIGHT=
WAF_MIN_GAP_MS=
WAF_SOFT_GAP_MS=
WAF_SOFT_INFLIGHT=
